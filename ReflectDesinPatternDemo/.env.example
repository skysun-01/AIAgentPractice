# Copy this file to .env (in this ReflectDesinPatternDemo folder) and fill in your key(s).
# Both projects read it: ChartGenerationAgent and SqlQueryImprover.

# OpenAI models (gpt-4o-mini, o4-mini, gpt-4.1, ...)
OPENAI_API_KEY=sk-...

# Anthropic models (claude-sonnet-5-5, ...) - only needed if you pick a Claude model
ANTHROPIC_API_KEY=sk-ant-...
